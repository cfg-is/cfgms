<?xml version="1.0" encoding="UTF-8"?>
<!--
  cfgms-steward.wxs — WiX 4 installer for CFGMS Steward

  Accepts these MSI properties for silent RMM deployment:
    REGTOKEN_FILE   Path to a file holding the registration token (required for a new install)
    CA_FINGERPRINT  SHA-256 hex fingerprint of the controller CA cert (required for private CA)
    CA_CERT_PATH    Path to CA cert PEM file (optional; auto-detected from SourceDir when ca.crt is present)

  Silent install from an extracted install package (includes ca.crt next to the MSI):
    msiexec /qn /i cfgms-steward-windows-amd64.msi REGTOKEN_FILE="C:\path\token.txt" CA_FINGERPRINT="<hex>"

  Silent install specifying the CA cert explicitly:
    msiexec /qn /i cfgms-steward-windows-amd64.msi REGTOKEN_FILE="C:\path\token.txt" CA_FINGERPRINT="<hex>" CA_CERT_PATH="C:\path\to\ca.crt"

  The token value is never an MSI property and never appears on a command line;
  only the file path does. Before running msiexec, write the token to the file and
  restrict it to SYSTEM and Administrators. The install custom action runs as
  SYSTEM, so SYSTEM must be able to read the file. Delete the file once the install
  has finished.

  Installs the binary to C:\Program Files\CFGMS\ and runs "cfgms-steward install"
  with the regtoken-file flag set to REGTOKEN_FILE, the fingerprint flag set to
  CA_FINGERPRINT and, when CA_CERT_PATH is set, the controller-ca flag set to it.
  (Flag names are written without their leading dashes because an XML comment
  cannot contain a double dash.)

  The custom action is deferred and runs as SYSTEM (Impersonate="no") so it has the
  Administrator rights required for Windows Service registration.

  Build with build-msi.ps1:
    .\build\windows\build-msi.ps1 -ControllerURL https://ctrl.example.com -Version v1.0.0
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="CFGMS Steward"
           Manufacturer="CFGMS"
           Version="$(var.ProductVersion)"
           Language="1033"
           UpgradeCode="{A5B3C0D1-E2F4-4A6B-8C9D-0E1F2A3B4C5D}"
           Compressed="yes">

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of CFGMS Steward is already installed. Uninstall it before installing an older version." />

    <MediaTemplate EmbedCab="yes" />

    <!--
      Public MSI properties for RMM silent deployment.
      All uppercase names make them settable from the msiexec command line.
      Secure="yes" ensures they are passed through to deferred custom actions.
    -->
    <Property Id="REGTOKEN_FILE" Secure="yes" />
    <Property Id="CA_FINGERPRINT" Secure="yes" />

    <!--
      A new install fails closed without REGTOKEN_FILE. Installed products are
      exempt so that repair and uninstall, which do not register the steward, do
      not need it.
    -->
    <Launch Condition="Installed OR REGTOKEN_FILE"
            Message="REGTOKEN_FILE is required: pass REGTOKEN_FILE=&quot;C:\path\token.txt&quot; naming a file that holds the registration token." />

    <!--
      CA_CERT_PATH is auto-detected from the MSI source directory.
      When the install package (tar.gz from Story 2) is extracted alongside the MSI,
      ca.crt is present in the same directory and CA_CERT_PATH is set automatically.
      A user-supplied CA_CERT_PATH on the msiexec command line takes precedence
      over the auto-detected value (MSI public property semantics).
    -->
    <Property Id="CA_CERT_PATH" Secure="yes">
      <DirectorySearch Id="SourceCACertDirSearch" Path="[SourceDir]" Depth="0">
        <FileSearch Name="ca.crt" />
      </DirectorySearch>
    </Property>

    <!--
      Installation directory: C:\Program Files\CFGMS\
      ProgramFiles64Folder maps to C:\Program Files\ on both AMD64 and ARM64 Windows.
    -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="CFGMSDIR" Name="CFGMS">
        <Component Id="StewardBinary" Guid="*">
          <File Id="StewardExe"
                Source="$(var.BinaryPath)"
                Name="cfgms-steward.exe"
                KeyPath="yes" />
        </Component>
        <!--
          Launcher binary — must be in the MSI payload next to cfgms-steward.exe
          BEFORE the RunInstall* custom actions run: cfgms-steward.exe install
          (windowsManager.Install) fails closed when the launcher is absent, and
          registers the service to exec the launcher (launcher-managed install,
          push-upgradeable). Bundled only; never fetched post-install.
        -->
        <Component Id="StewardLauncherBinary" Guid="*">
          <File Id="StewardLauncherExe"
                Source="$(var.LauncherPath)"
                Name="cfgms-steward-launcher.exe"
                KeyPath="yes" />
        </Component>
        <!--
          Stdlib modules ship as signed bundle installation roots (Issue #4431): one
          subdirectory per module under modules\, each holding the publisher's
          module.yaml, the bundle.yaml sidecar (content hash + signature) and the
          module binary. $(var.ModulesDir) is the assembled per-module tree produced
          by build-msi.ps1 via scripts/sign-module-bundle, after Authenticode signing.
          The directory Id convention MODULEDIR_<NAME> is parsed by
          scripts/check-stdlib-payload-boundary.sh.
        -->
        <Directory Id="MODULESDIR" Name="modules">
          <Directory Id="MODULEDIR_CERT_TRUST" Name="cert_trust">
            <Component Id="ModuleCertTrust" Guid="{01C7F0D0-6EE1-4C6F-A7D8-E85CE07268C4}">
              <File Id="ModuleCertTrustExe" Source="$(var.ModulesDir)\cert_trust\cfgms-module-cert_trust.exe" Name="cfgms-module-cert_trust.exe" KeyPath="yes" />
              <File Id="ModuleCertTrustManifest" Source="$(var.ModulesDir)\cert_trust\module.yaml" Name="module.yaml" />
              <File Id="ModuleCertTrustSidecar" Source="$(var.ModulesDir)\cert_trust\bundle.yaml" Name="bundle.yaml" />
            </Component>
          </Directory>
          <Directory Id="MODULEDIR_FILE" Name="file">
            <Component Id="ModuleFile" Guid="{18487531-6810-4616-8D81-CACBF96480ED}">
              <File Id="ModuleFileExe" Source="$(var.ModulesDir)\file\cfgms-module-file.exe" Name="cfgms-module-file.exe" KeyPath="yes" />
              <File Id="ModuleFileManifest" Source="$(var.ModulesDir)\file\module.yaml" Name="module.yaml" />
              <File Id="ModuleFileSidecar" Source="$(var.ModulesDir)\file\bundle.yaml" Name="bundle.yaml" />
            </Component>
          </Directory>
          <Directory Id="MODULEDIR_SERVICE" Name="service">
            <Component Id="ModuleService" Guid="{655FB4F1-CDBA-49E5-BA54-66F33D7C991D}">
              <File Id="ModuleServiceExe" Source="$(var.ModulesDir)\service\cfgms-module-service.exe" Name="cfgms-module-service.exe" KeyPath="yes" />
              <File Id="ModuleServiceManifest" Source="$(var.ModulesDir)\service\module.yaml" Name="module.yaml" />
              <File Id="ModuleServiceSidecar" Source="$(var.ModulesDir)\service\bundle.yaml" Name="bundle.yaml" />
            </Component>
          </Directory>
          <Directory Id="MODULEDIR_PACKAGE" Name="package">
            <Component Id="ModulePackage" Guid="{789DBBEE-AF35-4CC6-BA33-54DFB51F9AF9}">
              <File Id="ModulePackageExe" Source="$(var.ModulesDir)\package\cfgms-module-package.exe" Name="cfgms-module-package.exe" KeyPath="yes" />
              <File Id="ModulePackageManifest" Source="$(var.ModulesDir)\package\module.yaml" Name="module.yaml" />
              <File Id="ModulePackageSidecar" Source="$(var.ModulesDir)\package\bundle.yaml" Name="bundle.yaml" />
            </Component>
          </Directory>
          <Directory Id="MODULEDIR_SCRIPT" Name="script">
            <Component Id="ModuleScript" Guid="{378C8619-B64C-479F-933A-286E04096314}">
              <File Id="ModuleScriptExe" Source="$(var.ModulesDir)\script\cfgms-module-script.exe" Name="cfgms-module-script.exe" KeyPath="yes" />
              <File Id="ModuleScriptManifest" Source="$(var.ModulesDir)\script\module.yaml" Name="module.yaml" />
              <File Id="ModuleScriptSidecar" Source="$(var.ModulesDir)\script\bundle.yaml" Name="bundle.yaml" />
            </Component>
          </Directory>
          <Directory Id="MODULEDIR_FIREWALL" Name="firewall">
            <Component Id="ModuleFirewall" Guid="{6BA8DEF7-DD89-4533-94D3-389776D09C73}">
              <File Id="ModuleFirewallExe" Source="$(var.ModulesDir)\firewall\cfgms-module-firewall.exe" Name="cfgms-module-firewall.exe" KeyPath="yes" />
              <File Id="ModuleFirewallManifest" Source="$(var.ModulesDir)\firewall\module.yaml" Name="module.yaml" />
              <File Id="ModuleFirewallSidecar" Source="$(var.ModulesDir)\firewall\bundle.yaml" Name="bundle.yaml" />
            </Component>
          </Directory>
          <Directory Id="MODULEDIR_HOSTNAME" Name="hostname">
            <Component Id="ModuleHostname" Guid="{2A310DEE-532F-40B0-8ECF-1ACB6B6B9B10}">
              <File Id="ModuleHostnameExe" Source="$(var.ModulesDir)\hostname\cfgms-module-hostname.exe" Name="cfgms-module-hostname.exe" KeyPath="yes" />
              <File Id="ModuleHostnameManifest" Source="$(var.ModulesDir)\hostname\module.yaml" Name="module.yaml" />
              <File Id="ModuleHostnameSidecar" Source="$(var.ModulesDir)\hostname\bundle.yaml" Name="bundle.yaml" />
            </Component>
          </Directory>
          <Directory Id="MODULEDIR_PATCH" Name="patch">
            <Component Id="ModulePatch" Guid="{081B75C1-A3DF-4DEB-8AF0-F5EC19D92346}">
              <File Id="ModulePatchExe" Source="$(var.ModulesDir)\patch\cfgms-module-patch.exe" Name="cfgms-module-patch.exe" KeyPath="yes" />
              <File Id="ModulePatchManifest" Source="$(var.ModulesDir)\patch\module.yaml" Name="module.yaml" />
              <File Id="ModulePatchSidecar" Source="$(var.ModulesDir)\patch\bundle.yaml" Name="bundle.yaml" />
            </Component>
          </Directory>
          <Directory Id="MODULEDIR_TIME" Name="time">
            <Component Id="ModuleTime" Guid="{E188F106-F1A0-4A55-AD08-090B78647C16}">
              <File Id="ModuleTimeExe" Source="$(var.ModulesDir)\time\cfgms-module-time.exe" Name="cfgms-module-time.exe" KeyPath="yes" />
              <File Id="ModuleTimeManifest" Source="$(var.ModulesDir)\time\module.yaml" Name="module.yaml" />
              <File Id="ModuleTimeSidecar" Source="$(var.ModulesDir)\time\bundle.yaml" Name="bundle.yaml" />
            </Component>
          </Directory>
          <Directory Id="MODULEDIR_USER" Name="user">
            <Component Id="ModuleUser" Guid="{7536AC18-F179-45A0-94C0-AE6432F3965D}">
              <File Id="ModuleUserExe" Source="$(var.ModulesDir)\user\cfgms-module-user.exe" Name="cfgms-module-user.exe" KeyPath="yes" />
              <File Id="ModuleUserManifest" Source="$(var.ModulesDir)\user\module.yaml" Name="module.yaml" />
              <File Id="ModuleUserSidecar" Source="$(var.ModulesDir)\user\bundle.yaml" Name="bundle.yaml" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="ProductFeature" Title="CFGMS Steward" Level="1">
      <ComponentRef Id="StewardBinary" />
      <ComponentRef Id="StewardLauncherBinary" />
      <ComponentRef Id="ModuleCertTrust" />
      <ComponentRef Id="ModuleFile" />
      <ComponentRef Id="ModuleService" />
      <ComponentRef Id="ModulePackage" />
      <ComponentRef Id="ModuleScript" />
      <ComponentRef Id="ModuleFirewall" />
      <ComponentRef Id="ModuleHostname" />
      <ComponentRef Id="ModulePatch" />
      <ComponentRef Id="ModuleTime" />
      <ComponentRef Id="ModuleUser" />
    </Feature>

    <!--
      Custom action — install without CA cert (when CA_CERT_PATH is not set).
      Runs after the binary is installed so cfgms-steward.exe is available at
      C:\Program Files\CFGMS\cfgms-steward.exe for Windows Service registration.
    -->
    <!--
      The command line is the ExeCommand (CustomAction Target). A deferred action's
      Target is formatted when the install script is generated, so [REGTOKEN_FILE]
      resolves to the path: the token value itself never reaches a command line.
    -->
    <CustomAction Id="RunInstallNoCert"
                  FileRef="StewardExe"
                  ExeCommand="install --regtoken-file &quot;[REGTOKEN_FILE]&quot; --fingerprint &quot;[CA_FINGERPRINT]&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!--
      Custom action — install with CA cert (when CA_CERT_PATH is set, either via
      auto-detection or explicit command-line property).
    -->
    <CustomAction Id="RunInstallWithCert"
                  FileRef="StewardExe"
                  ExeCommand="install --regtoken-file &quot;[REGTOKEN_FILE]&quot; --fingerprint &quot;[CA_FINGERPRINT]&quot; --controller-ca &quot;[CA_CERT_PATH]&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!--
      Custom action — uninstall the Windows service before the binary is removed.
      Runs before RemoveFiles so cfgms-steward.exe is still on disk when called.
      Return="ignore" allows uninstall to proceed even if the service was already
      removed or was never registered (idempotent cleanup).
    -->
    <CustomAction Id="RunUninstall"
                  FileRef="StewardExe"
                  ExeCommand="uninstall"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- Uninstall service before RemoveFiles (so the binary is still on disk) -->
      <Custom Action="RunUninstall" Before="RemoveFiles" Condition="Installed AND REMOVE~=&quot;ALL&quot;" />
      <!-- Install without CA cert when CA_CERT_PATH is not set -->
      <Custom Action="RunInstallNoCert" After="InstallFiles" Condition="NOT Installed AND NOT CA_CERT_PATH" />
      <!-- Install with CA cert when CA_CERT_PATH is set (auto-detected or explicit) -->
      <Custom Action="RunInstallWithCert" After="InstallFiles" Condition="NOT Installed AND CA_CERT_PATH" />
    </InstallExecuteSequence>

  </Package>
</Wix>
